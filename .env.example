# Ключ нужен ТОЛЬКО для текстовых объяснений.
# Без него приложение работает: рейтинг с цифрами считается детерминированно.
GEMINI_API_KEY=

# Максимум запросов к LLM в сутки на всё приложение.
# При достижении лимита советник молча переходит в режим "только цифры".
LLM_DAILY_BUDGET=200

# Максимум запросов к LLM в сутки на одного пользователя.
# Актуально для бота: друзья не должны выесть общий лимит.
LLM_USER_DAILY_BUDGET=30

# Токен от @BotFather. Нужен только для телеграм-бота, веб-интерфейсу — нет.
TELEGRAM_BOT_TOKEN=
